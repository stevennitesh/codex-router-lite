diff --git a/codex-rs/windows-sandbox-rs/src/acl_tests.rs b/codex-rs/windows-sandbox-rs/src/acl_tests.rs
index 44a1cd90..5ee35907 100644
--- a/codex-rs/windows-sandbox-rs/src/acl_tests.rs
+++ b/codex-rs/windows-sandbox-rs/src/acl_tests.rs
@@ -27,6 +27,31 @@ use windows_sys::Win32::Storage::FileSystem::FILE_FLAG_BACKUP_SEMANTICS;
 use windows_sys::Win32::Storage::FileSystem::FILE_READ_ATTRIBUTES;
 use windows_sys::Win32::Storage::FileSystem::READ_CONTROL;
 
+#[test]
+fn root_only_read_execute_grant_allows_a_file_without_write_sharing() {
+    let fixture = tempfile::tempdir().expect("fixture directory");
+    let path = fixture.path().join("loaded-runtime.exe");
+    std::fs::write(&path, b"synthetic executable image").expect("fixture file");
+    // A running image denies data-write sharing. ACL access should still work.
+    let _loaded_image = OpenOptions::new()
+        .read(true)
+        .share_mode(super::FILE_SHARE_READ)
+        .open(&path)
+        .expect("hold the runtime image open without write sharing");
+    let sid = LocalSid::from_string("S-1-5-21-10-20-30-40").expect("test SID");
+    let changed = unsafe { super::grant_read_execute_aces(&path, &[sid.as_ptr()], 0) }
+        .expect("ACL-only access must not request executable data-write access");
+    assert!(changed);
+    assert!(super::path_mask_allows(
+        &path,
+        &[sid.as_ptr()],
+        super::FILE_GENERIC_READ | super::FILE_GENERIC_EXECUTE,
+        true,
+    ).expect("read the resulting ACL"));
+    assert!(!unsafe { super::grant_read_execute_aces(&path, &[sid.as_ptr()], 0) }
+        .expect("the grant should be idempotent"));
+}

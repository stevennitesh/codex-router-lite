+async fn mount_hook_context_mcp_server(
+    server: &MockServer,
+    endpoint: &str,
+    supports_sandbox_state: bool,
+) {
+    Mock::given(method("POST"))
+        .and(path(endpoint))
+        .respond_with(move |request: &Request| {
+            let request: Value = serde_json::from_slice(&request.body).expect("valid MCP request");
+            let result = match request["method"].as_str() {
+                Some("initialize") => {
+                    let mut capabilities = json!({ "tools": {} });
+                    if supports_sandbox_state {
+                        capabilities["experimental"] = json!({ "codex/sandbox-state": {} });
+                    }
+                    json!({
+                        "protocolVersion": request["params"]["protocolVersion"],
+                        "capabilities": capabilities,
+                        "serverInfo": { "name": RMCP_SERVER, "version": "1.0.0" },
+                    })
+                }
+                Some("notifications/initialized") => return ResponseTemplate::new(202),
+                Some("tools/list") => json!({ "tools": [
+                    {
+                        "name": "read_context",
+                        "inputSchema": { "type": "object" },
+                        "annotations": { "readOnlyHint": true },
+                    },
+                    {
+                        "name": "cleanup",
+                        "inputSchema": { "type": "object" },
+                        "_meta": { "ui": { "visibility": [] } },
+                    },
+                ] }),
+                Some("tools/call") => json!({
+                    "content": [{ "type": "text", "text": "{}" }],
+                }),
+                other => panic!("unexpected MCP method: {other:?}"),
+            };
+            ResponseTemplate::new(200).set_body_json(json!({
+                "jsonrpc": "2.0",
+                "id": request["id"],
+                "result": result,
+            }))
+        })
+        .mount(server)
+        .await;
+}
+
+fn write_context_mcp_hook(home: &Path, event_name: &str) -> Result<()> {
+    let hooks = json!({
+        "hooks": {
+            event_name: [{
+                "matcher": (event_name == "PostToolUse").then_some("mcp__rmcp__read_context"),
+                "hooks": [{
+                    "type": "mcp_tool",
+                    "server": RMCP_SERVER,
+                    "tool": "cleanup",
+                    "input": { "event": "${hook_event_name}" },
+                    "timeout": 20,
+                }],
+            }],
+        },
+    });
+    fs::write(home.join("hooks.json"), hooks.to_string()).context("write context MCP hook")
+}
+
+async fn context_mcp_calls(server: &MockServer, endpoint: &str) -> Result<Vec<Value>> {
+    Ok(server
+        .received_requests()
+        .await
+        .context("MCP server should record requests")?
+        .into_iter()
+        .filter(|request| request.url.path() == endpoint)
+        .filter_map(|request| serde_json::from_slice::<Value>(&request.body).ok())
+        .filter(|request| request["method"] == "tools/call")
+        .collect())
+}
+
+fn assert_hook_matches_model_mcp_context(
+    test: &TestCodex,
+    response_request: &Value,
+    ordinary_call: &Value,
+    hook_call: &Value,
+    supports_sandbox_state: bool,
+) -> Result<()> {
+    let ordinary_meta = ordinary_call["params"]["_meta"]
+        .as_object()
+        .context("ordinary MCP call metadata")?;
+    let hook_meta = hook_call["params"]["_meta"]
+        .as_object()
+        .context("hook MCP call metadata")?;
+    assert_eq!(ordinary_meta["callId"], "read-context");
+    assert!(hook_meta.get("callId").is_none());
+    assert!(hook_meta.get("itemId").is_none());
+    // A hook is a fresh RPC without the originating model item's UI bookkeeping.
+    let ordinary_progress = ordinary_meta
+        .get("progressToken")
+        .context("ordinary MCP call progress token")?;
+    let hook_progress = hook_meta
+        .get("progressToken")
+        .context("hook MCP call progress token")?;
+    assert_ne!(ordinary_progress, hook_progress);
+
+    let response_metadata: Value = serde_json::from_str(
+        response_request["client_metadata"]["x-codex-turn-metadata"]
+            .as_str()
+            .context("model request turn metadata")?,
+    )?;
+    let turn_metadata = &hook_meta["x-codex-turn-metadata"];
+    assert_eq!(turn_metadata, &ordinary_meta["x-codex-turn-metadata"]);
+    // Responses adds request/window/history fields; MCP carries the same canonical
+    // execution metadata with its own native version, without that UI bookkeeping.
+    let mut expected_turn_metadata = response_metadata
+        .as_object()
+        .context("model request turn metadata object")?
+        .clone();
+    for field in [
+        "installation_id",
+        "agent_name",
+        "window_id",
+        "window_number",
+        "context_window_id",
+        "request_kind",
+        "history_initialization",
+        "history_ingest_requested",
+        "analytics_enabled",
+        "parent_turn_id",
+        "root_turn_id",
+        "tool_namespaces_info",
+    ] {
+        expected_turn_metadata.remove(field);
+    }
+    expected_turn_metadata.insert(
+        "codex_version".to_string(),
+        json!(env!("CARGO_PKG_VERSION")),
+    );
+    assert_eq!(turn_metadata, &Value::Object(expected_turn_metadata));
+    for field in ["session_id", "thread_id", "turn_id", "model"] {
+        assert!(
+            turn_metadata[field]
+                .as_str()
+                .is_some_and(|value| !value.is_empty()),
+            "MCP metadata must include {field}",
+        );
+        assert_eq!(turn_metadata[field], response_metadata[field]);
+    }
+    assert_eq!(
+        hook_meta["threadId"],
+        test.session_configured.thread_id.to_string()
+    );
+    assert_eq!(hook_meta["threadId"], ordinary_meta["threadId"]);
+    assert!(hook_meta.get("openai/entitlementContext").is_none());
+    // HTTP servers have no verified local sandbox launcher.
+    assert!(hook_meta.get(MCP_SANDBOX_LAUNCHER_META_KEY).is_none());
+    if supports_sandbox_state {
+        let expected_state = serde_json::to_value(SandboxState {
+            permission_profile: PermissionProfile::read_only(),
+            codex_linux_sandbox_exe: test.config.codex_linux_sandbox_exe.clone(),
+            sandbox_cwd: PathUri::from_abs_path(&test.config.cwd),
+            use_legacy_landlock: false,
+            use_mxc: false,
+        })?;
+        for key in [
+            MCP_SANDBOX_STATE_CAPABILITY,
+            MCP_SANDBOX_STATE_META_CAPABILITY,
+        ] {
+            assert_eq!(hook_meta[key], ordinary_meta[key]);
+            assert_eq!(hook_meta[key], expected_state);
+        }
+    } else {
+        for key in [
+            MCP_SANDBOX_STATE_CAPABILITY,
+            MCP_SANDBOX_STATE_META_CAPABILITY,
+        ] {
+            assert!(hook_meta.get(key).is_none());
+            assert!(ordinary_meta.get(key).is_none());
+        }
+    }
+    Ok(())
+}

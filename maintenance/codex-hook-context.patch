+#[test_case(true; "captured enabled tool remains callable")]
+#[test_case(false; "captured disabled tool remains denied")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_interrupt_hook_keeps_originating_mcp_client_and_policy(
+    cleanup_initially_enabled: bool,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    mount_hook_context_mcp_server(&server, "/originating-context", true).await;
+    mount_hook_context_mcp_server(&server, "/replacement-context", false).await;
+    let responses = mount_response_sequence(
+        &server,
+        vec![
+            sse_response(sse(vec![
+                ev_response_created("read-context-response"),
+                ev_function_call_with_namespace(
+                    "read-context",
+                    RMCP_PREFIXED_NAMESPACE,
+                    "read_context",
+                    "{}",
+                ),
+                ev_completed("read-context-response"),
+            ])),
+            sse_response(sse(vec![ev_completed("waiting-response")]))
+                .set_delay(Duration::from_secs(60)),
+        ],
+    )
+    .await;
+    let mcp_url = format!("{}/originating-context", server.uri());
+    let test = test_codex()
+        .with_pre_build_hook(|home| {
+            write_context_mcp_hook(home, "Interrupt").expect("write Interrupt MCP hook");
+        })
+        .with_config(move |config| {
+            trust_discovered_hooks(config);
+            config
+                .mcp_servers
+                .set(HashMap::from([(
+                    RMCP_SERVER.to_string(),
+                    serde_json::from_value(json!({
+                        "url": mcp_url,
+                        "disabled_tools": if cleanup_initially_enabled { vec![] } else { vec!["cleanup"] },
+                    }))
+                    .expect("originating MCP server config"),
+                )]))
+                .expect("configure originating MCP server");
+        })
+        .build(&server)
+        .await?;
+    wait_for_mcp_server(&test.codex, RMCP_SERVER).await?;
+    let (sandbox_policy, permission_profile) =
+        turn_permission_fields(PermissionProfile::read_only(), test.config.cwd.as_path());
+    test.codex
+        .start_or_steer_turn(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "read context, then wait".to_string(),
+                text_elements: Vec::new(),
+            }])
+            .with_thread_settings(ThreadSettingsOverrides {
+                approval_policy: Some(AskForApproval::Never),
+                sandbox_policy: Some(sandbox_policy),
+                permission_profile,
+                ..Default::default()
+            }),
+        )
+        .await?;
+    tokio::time::timeout(Duration::from_secs(10), async {
+        while responses.requests().len() != 2 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .context("ordinary MCP call must finish before config replacement")?;
+
+    let current_config = test.codex.config().await;
+    let mut replacement_config = (*current_config).clone();
+    replacement_config.mcp_servers.set(HashMap::from([(
+        RMCP_SERVER.to_string(),
+        serde_json::from_value(json!({
+            "url": format!("{}/replacement-context", server.uri()),
+            "disabled_tools": if cleanup_initially_enabled { vec!["cleanup"] } else { vec![] },
+        }))?,
+    )]))?;
+    assert_eq!(
+        test.codex
+            .refresh_mcp_config(current_config, replacement_config)
+            .await,
+        ConfigRefreshOutcome::Published,
+    );
+    // Publishing and using the replacement removes any race with background prewarm.
+    test.codex
+        .call_mcp_tool("rmcp", "read_context", Some(json!({})), None)
+        .await?;
+    assert_eq!(
+        context_mcp_calls(&server, "/replacement-context")
+            .await?
+            .len(),
+        1
+    );
+
+    let completed = tokio::time::timeout(Duration::from_secs(3), async {
+        test.codex.submit(Op::Interrupt).await?;
+        let completed = wait_for_event_match(&test.codex, |event| match event {
+            EventMsg::HookCompleted(completed)
+                if completed.run.event_name == HookEventName::Interrupt =>
+            {
+                Some(completed.clone())
+            }
+            EventMsg::TurnAborted(_) => panic!("Interrupt cleanup must precede TurnAborted"),
+            _ => None,
+        })
+        .await;
+        let aborted = wait_for_event_match(&test.codex, |event| match event {
+            EventMsg::TurnAborted(aborted) => Some(aborted.clone()),
+            _ => None,
+        })
+        .await;
+        assert_eq!(aborted.reason, TurnAbortReason::Interrupted);
+        Ok::<_, anyhow::Error>(completed)
+    })
+    .await
+    .context("Interrupt cleanup and TurnAborted must complete within three seconds")??;
+
+    let originating_calls = context_mcp_calls(&server, "/originating-context").await?;
+    let replacement_calls = context_mcp_calls(&server, "/replacement-context").await?;
+    assert_eq!(
+        replacement_calls.len(),
+        1,
+        "cleanup must not use the replacement client"
+    );
+    if cleanup_initially_enabled {
+        assert_eq!(completed.run.status, HookRunStatus::Completed);
+        assert_eq!(originating_calls.len(), 2);
+        assert_eq!(originating_calls[1]["params"]["name"], "cleanup");
+        assert_eq!(
+            originating_calls[1]["params"]["arguments"],
+            json!({ "event": "Interrupt" })
+        );
+        assert_hook_matches_model_mcp_context(
+            &test,
+            &responses.requests()[0].body_json(),
+            &originating_calls[0],
+            &originating_calls[1],
+            true,
+        )?;
+    } else {
+        assert_eq!(completed.run.status, HookRunStatus::Failed);
+        assert_eq!(
+            originating_calls.len(),
+            1,
+            "captured tool filters must still apply"
+        );
+        assert!(
+            completed
+                .run
+                .entries
+                .iter()
+                .any(|entry| entry.text.contains("disabled"))
+        );
+    }
+    Ok(())
+}

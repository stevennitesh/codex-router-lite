+    for (server_timeout, hook_timeout) in [
+        (Duration::from_millis(20), Duration::from_secs(5)),
+        (Duration::from_secs(5), Duration::from_millis(20)),
+    ] {
+        let mut client = model_call.client.as_ref().clone();
+        client.tool_timeout = Some(server_timeout);
+        let prepared = PreparedHookMcpCall {

+/// One hook dispatch retains its actual step even after the task is cancelled
+/// or a newer MCP runtime configuration is published.
+pub(crate) struct StepHookMcpExecutor {
+    thread_id: ThreadId,
+    request_metadata: Map<String, Value>,
+    context: Option<StepHookMcpContext>,
+}
+
+struct StepHookMcpContext {
+    mcp: Arc<McpBinding>,
+    environments: TurnEnvironmentSnapshot,
+    fallback_cwd: AbsolutePathBuf,
+}
+
+impl StepHookMcpExecutor {
+    pub(crate) fn new(
+        thread_id: ThreadId,
+        request_metadata: Map<String, Value>,
+        step_context: Option<&StepContext>,
+    ) -> Self {
+        Self {
+            thread_id,
+            request_metadata,
+            context: step_context.map(|step_context| StepHookMcpContext {
+                mcp: Arc::clone(&step_context.mcp),
+                environments: step_context.environments.clone(),
+                #[allow(deprecated)]
+                fallback_cwd: step_context.turn.cwd.clone(),
+            }),
+        }
+    }
+}
+
+impl HookMcpExecutor for StepHookMcpExecutor {
+    fn execute(&self, call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+        async move {
+            let Some(context) = &self.context else {
+                bail!("MCP hook has no originating step binding");
+            };
+            let prepared = context.mcp.prepare_hook_call(
+                &call.server,
+                &call.tool,
+                call.environment_id.as_deref(),
+            )?;
+            let mut metadata = call.metadata.unwrap_or_default();
+            // Only the host's canonical metadata may identify this invocation.
+            metadata.remove(crate::X_CODEX_TURN_METADATA_HEADER);
+            // Sandbox authority also comes exclusively from the retained binding.
+            metadata.remove(MCP_SANDBOX_STATE_CAPABILITY);
+            metadata.remove(MCP_SANDBOX_STATE_META_CAPABILITY);
+            metadata.remove(MCP_SANDBOX_LAUNCHER_META_KEY);
+            metadata.extend(self.request_metadata.clone());
+            metadata.insert(
+                "threadId".to_string(),
+                Value::String(self.thread_id.to_string()),
+            );
+            let result = prepared
+                .call_with_preparation(call.timeout, || async {
+                    let mut meta = Some(Value::Object(metadata));
+                    if prepared.server_supports_sandbox_state_meta_capability()
+                        && let Some(state) = mcp_sandbox_state(
+                            prepared.config(),
+                            prepared.permission_profile(),
+                            prepared.server_environment_id(),
+                            &context.environments,
+                            &context.fallback_cwd,
+                        )
+                    {
+                        prepared.augment_sandbox_metadata(&mut meta, state).await?;
+                    }
+                    Ok((Some(Value::Object(call.input)), meta))
+                })
+                .await?;
+            hook_result_text(result)
+        }
+        .boxed()
+    }
+}
+
+fn hook_result_text(result: codex_protocol::mcp::CallToolResult) -> anyhow::Result<String> {
+    let text = result
+        .content
+        .iter()
+        .filter_map(|content| {
+            (content.get("type").and_then(Value::as_str) == Some("text"))
+                .then(|| content.get("text").and_then(Value::as_str))
+                .flatten()
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    if result.is_error == Some(true) {
+        bail!("MCP tool returned an error: {text}");
+    }
+    Ok(text)
+}

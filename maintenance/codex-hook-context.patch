+            server_name: SERVER_NAME.to_owned(),
+            tool_name: TOOL_NAME.to_owned(),
+            server_metadata: model_call.server_metadata.clone(),
+        };
+        let preparation_started = AtomicBool::new(false);
+        let error = tokio::time::timeout(
+            Duration::from_secs(1),
+            prepared.call_with_preparation(hook_timeout, || async {
+                preparation_started.store(true, Ordering::SeqCst);
+                // Launcher probing, OAuth, or another preparation dependency
+                // cannot keep Interrupt alive past its configured deadline.
+                std::future::pending().await
+            }),
+        )
+        .await
+        .expect("the shorter deadline must include preparation, before tools/call")
+        .expect_err("unfinished preparation must time out");
+        assert!(preparation_started.load(Ordering::SeqCst));
+        assert!(
+            error.to_string().contains("timed out awaiting tools/call"),
+            "unexpected preparation error: {error:#}"
+        );
+    }
+}

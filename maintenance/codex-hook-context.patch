+/// A configured hook's exact ready client and permission authority.
+/// Unlike model calls, hooks do not receive host-owned entitlement authority.
+pub struct PreparedHookMcpCall {
+    // Keep server connections alive even when the originating binding is dropped.
+    _connections: Arc<McpConnectionSet>,
+    client: Arc<ManagedClient>,
+    config: Arc<McpConfig>,
+    server_name: String,
+    tool_name: String,
+    server_metadata: McpServerMetadata,
+}
+
+impl PreparedHookMcpCall {
+    pub fn config(&self) -> &McpConfig {
+        &self.config
+    }
+
+    pub fn permission_profile(&self) -> &PermissionProfile {
+        let Some(permission_profile) = self.config.permission_profile_for_server(&self.server_name)
+        else {
+            unreachable!("prepared hook calls retain their immutable permission authority");
+        };
+        permission_profile
+    }
+
+    pub fn server_environment_id(&self) -> &str {
+        &self.server_metadata.environment_id
+    }
+
+    /// Capabilities come from the same initialized client that executes this hook.
+    pub fn server_supports_sandbox_state_meta_capability(&self) -> bool {
+        self.client.server_supports_sandbox_state_meta_capability
+    }
+
+    pub async fn augment_sandbox_metadata(
+        &self,
+        meta: &mut Option<JsonValue>,
+        state: crate::SandboxState,
+    ) -> Result<()> {
+        crate::sandbox_metadata::augment_metadata(
+            meta,
+            state,
+            sandbox_codex_executable(
+                &self.config,
+                &self.server_name,
+                self.server_environment_id(),
+            )
+            .await,
+        )
+    }
+
+    /// Preparation and dispatch share the more restrictive server/hook deadline.
+    pub async fn call_with_preparation<F, Fut>(
+        &self,
+        requested_timeout: Duration,
+        prepare: F,
+    ) -> Result<CallToolResult>
+    where
+        F: FnOnce() -> Fut,
+        Fut: Future<Output = Result<(Option<JsonValue>, Option<JsonValue>)>>,
+    {
+        let timeout = self
+            .client
+            .tool_timeout
+            .map_or(requested_timeout, |timeout| timeout.min(requested_timeout));
+        tokio::time::timeout(timeout, async {
+            if self.client.client.is_closed().await {
+                anyhow::bail!("MCP server '{}' is not connected", self.server_name);
+            }
+            let (arguments, mut meta) = prepare().await?;
+            if let Some(JsonValue::Object(meta)) = meta.as_mut() {
+                meta.remove(crate::trusted_access::ENTITLEMENT_CONTEXT_KEY);
+            }
+            self.client
+                .client
+                .call_tool(self.tool_name.clone(), arguments, meta, Some(timeout))
+                .await
+                .map(call_tool_result_from_rmcp)
+                .with_context(|| {
+                    format!(
+                        "tool call failed for `{}/{}`",
+                        self.server_name, self.tool_name
+                    )
+                })
+        })
+        .await
+        .map_err(|_| anyhow::anyhow!("timed out awaiting tools/call after {timeout:.0?}"))?
     }
 }
 

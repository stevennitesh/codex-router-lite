+#[test_case(true; "advertised sandbox state")]
+#[test_case(false; "unadvertised sandbox state")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_post_tool_use_hook_preserves_model_mcp_context(
+    supports_sandbox_state: bool,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    mount_hook_context_mcp_server(&server, "/hook-context", supports_sandbox_state).await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("read-context-response"),
+                ev_function_call_with_namespace(
+                    "read-context",
+                    RMCP_PREFIXED_NAMESPACE,
+                    "read_context",
+                    "{}",
+                ),
+                ev_completed("read-context-response"),
+            ]),
+            sse(vec![
+                ev_assistant_message("done", "done"),
+                ev_completed("done"),
+            ]),
+        ],
+    )
+    .await;
+    let mcp_url = format!("{}/hook-context", server.uri());
+    let test = test_codex()
+        .with_pre_build_hook(|home| {
+            write_context_mcp_hook(home, "PostToolUse").expect("write PostToolUse MCP hook");
+        })
+        .with_config(move |config| {
+            trust_discovered_hooks(config);
+            config
+                .mcp_servers
+                .set(HashMap::from([(
+                    RMCP_SERVER.to_string(),
+                    serde_json::from_value(json!({ "url": mcp_url }))
+                        .expect("context MCP server config"),
+                )]))
+                .expect("configure context MCP server");
+        })
+        .build(&server)
+        .await?;
+    wait_for_mcp_server(&test.codex, RMCP_SERVER).await?;
+    test.submit_turn_with_permission_profile("read context", PermissionProfile::read_only())
+        .await?;
+
+    let calls = context_mcp_calls(&server, "/hook-context").await?;
+    assert_eq!(calls.len(), 2);
+    assert_eq!(calls[0]["params"]["name"], "read_context");
+    assert_eq!(calls[1]["params"]["name"], "cleanup");
+    assert_eq!(
+        calls[1]["params"]["arguments"],
+        json!({ "event": "PostToolUse" })
+    );
+    let requests = responses.requests();
+    assert_eq!(requests.len(), 2);
+    assert!(
+        requests[0]
+            .tool_by_name(RMCP_PREFIXED_NAMESPACE, "cleanup")
+            .is_none(),
+        "hook cleanup must remain hidden from the model",
+    );
+    assert_hook_matches_model_mcp_context(
+        &test,
+        &requests[0].body_json(),
+        &calls[0],
+        &calls[1],
+        supports_sandbox_state,
+    )?;
+    Ok(())
+}

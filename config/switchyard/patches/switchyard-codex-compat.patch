+/// Selects the latest decoded end-user turn without treating tool-result
+/// pseudo-user messages as user intent. The original request is never changed.
+fn latest_user_turn(messages: &[Message]) -> Option<SelectedUserTurn> {
+    messages.iter().rev().find_map(|message| {
+        if message.role != Role::User {
+            return None;
+        }
+        let text = message
+            .content
+            .iter()
+            .filter_map(|block| match block {
+                ContentBlock::Text { text } | ContentBlock::Refusal { text } => Some(text.as_str()),
+                _ => None,
+            })
+            .collect::<Vec<_>>()
+            .join("\n");
+        let has_non_text = message.content.iter().any(|block| match block {
+            ContentBlock::Image { .. }
+            | ContentBlock::Audio { .. }
+            | ContentBlock::Video { .. }
+            | ContentBlock::File { .. } => true,
+            ContentBlock::Unknown { provider, raw } => !unknown_is_control_only(provider, raw),
+            ContentBlock::Text { .. }
+            | ContentBlock::Reasoning { .. }
+            | ContentBlock::ToolCall(_)
+            | ContentBlock::ToolResult(_)
+            | ContentBlock::Refusal { .. } => false,
+        });
+        if text.trim().is_empty() && !has_non_text {
+            return None;
+        }
+        Some(SelectedUserTurn { text, has_non_text })
+    })

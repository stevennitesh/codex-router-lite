+
+fn raw_responses_has_new_user_turn(request: &Request) -> Option<bool> {
+    let input = request.raw_request.as_ref()?.get("input")?;
+    if input.is_string() {
+        return Some(true);
+    }
+    let item = input.as_array()?.last()?.as_object()?;
+    let item_type = item.get("type")?.as_str()?;
+    if RESPONSES_TOOL_OUTPUT_TYPES.contains(&item_type) {
+        return Some(false);
+    }
+    (item_type == "message")
+        .then(|| item.get("role").and_then(serde_json::Value::as_str) == Some("user"))
+}
+
+pub(crate) fn has_new_user_turn(request: &Request) -> bool {
+    raw_responses_has_new_user_turn(request).unwrap_or_else(|| {
+        request
+            .llm_request
+            .messages
+            .last()
+            .is_some_and(is_user_turn)
+    })
 }


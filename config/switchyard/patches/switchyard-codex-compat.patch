+// Recursively applies target-owned values after caller fields and defaults.
+// Object siblings survive, so overriding `reasoning.effort` does not erase a
+// native caller's `reasoning.context`, summary controls, or future fields.
+fn apply_body_overrides(body: &mut Value, body_overrides: &BTreeMap<String, Value>) {
+    let Value::Object(object) = body else {
+        return;
+    };
+    for (key, value) in body_overrides {
+        match object.get_mut(key) {
+            Some(existing) => merge_override_value(existing, value),
+            None => {
+                object.insert(key.clone(), value.clone());
+            }
+        }
+    }
+}
+
+fn merge_override_value(target: &mut Value, override_value: &Value) {
+    if let (Value::Object(target), Value::Object(overrides)) = (&mut *target, override_value) {
+        for (key, value) in overrides {
+            match target.get_mut(key) {
+                Some(existing) => merge_override_value(existing, value),
+                None => {
+                    target.insert(key.clone(), value.clone());
+                }
+            }
+        }
+    } else {
+        *target = override_value.clone();
+    }
+}
+
+fn apply_body_removals(body: &mut Value, body_removals: &[String]) {
+    let Value::Object(object) = body else {
+        return;
+    };
+    for key in body_removals {
+        object.remove(key);
+    }
+}

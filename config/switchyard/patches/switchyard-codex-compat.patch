+                {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "call_read", "content": "Tool result."}]},
+                {"role": "user", "content": "Fix decoder bug."}
+            ]}),
+        ),
+        (
+            "/v1/responses",
+            json!({"model": "typesafe", "input": [
+                {"role": "user", "content": [
+                    {"type": "input_text", "text": "Earlier turn."},

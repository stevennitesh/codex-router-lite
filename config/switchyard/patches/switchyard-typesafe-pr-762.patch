+                .push(ModelId::from(*target));
+        }
+        Driver::new("test", Arc::new(RuntimeModels::new(map))).0
+    }
+
+    fn config(options: Vec<TypeSafeOption>, base_threshold: f64) -> TypeSafeClassifierConfig {
+        TypeSafeClassifierConfig {
+            options,

{
  "name": "codex-router-lite",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Windows compatibility router for native Codex, OpenRouter GLM-5.3-Flash and Pareto, and Switchyard",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node scripts-check.mjs",
